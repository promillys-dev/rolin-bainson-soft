# Copier en .env.local (développement). En ligne : variables d'environnement
# de l'hébergeur. Mêmes noms que le front 3 (branche nouveau-front-3) et que
# l'API : la configuration de déploiement déjà en place sert telle quelle.

# ORIGINE de l'API Laravel, sans « /api/v1 » : serveur de test, ou
# http://127.0.0.1:8100 avec `php artisan serve --port=8100`.
# Absente, le site affiche ses données d'exemple (src/data) — jamais en
# production.
API_URL=http://127.0.0.1:8100

# Jeton partagé avec l'API (même valeur que FRONT_INTERNAL_TOKEN dans
# api/.env). Secret. Il authentifie l'adresse du visiteur transmise avec
# chaque envoi de formulaire (middleware TrustFrontRelay).
FRONT_INTERNAL_TOKEN=

# Secret de /api/revalidate (appelé par l'API quand un contenu change) :
# openssl rand -hex 32.
REVALIDATE_SECRET=

# Adresse publique du site (liens canoniques, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# TRANSITOIRE : certificat PUBLIC du serveur de test (auto-signé, aucun vrai
# certificat possible sur *.universe.wf), épinglé pour Node sans couper la
# vérification TLS. Sur une ligne :
#   awk 'NF {printf "%s\n", $0}' certs/api-o2switch-test.pem
# À vider quand l'API aura un vrai domaine. Demande Node 22.19+.
API_CA_CERT=
